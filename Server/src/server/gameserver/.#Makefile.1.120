#----------------------------------------------------------------------
# Directories Setting
#----------------------------------------------------------------------
#VSHOME   = ../../..
STLDIR   = /usr/include/STL
BINDIR   = $(VSHOME)/bin
LIBDIR   = $(VSHOME)/lib
LOGDIR   = $(VSHOME)/log
SRCDIR   = ../..
COREDIR  = ../../Core
SERVDIR  = ..
DBDIR    = ../database
MYSQLDIR = /usr/local/lib/mysql
SKILLDIR = ./skill
ITEMDIR  = ./item
BILLINGDIR  = ./billing
WARDIR  = ./war
COUPLEDIR = ./couple
TESTDIR  = ./test
MISSIONDIR = ./mission
CTFDIR = ./ctf
SCRIPTDIR = ./script
PYLIBDIR = /usr/local/lib/python2.2/config
PYINCDIR = /usr/local/include/python2.2
#GQUESTDIR = ./gq
#SIMPLEQUESTDIR  = ./quest/Squest

#----------------------------------------------------------------------
# General Rules
#----------------------------------------------------------------------
.SUFFIXES    : .cpp .o

CC       = g++
DEFS     = -D__LINUX__ -D_REENTRANT -D__GAME_SERVER__ -D__DEBUG__  -D__COMBAT__
INCLUDES = -I/usr/local/lua-5.1.3/include -I$(STLDIR) -I$(COREDIR) -I$(SERVDIR) -I$(DBDIR) -I$(SKILLDIR) -I$(ITEMDIR) -I$(BILLINGDIR) -I$(WARDIR) -I$(COUPLEDIR) -I$(TESTDIR) -I$(MISSIONDIR) -I$(SCRIPTDIR) -I.
CCFLAGS  = -Wall -c -g
#CCFLAGS  = -Wall -c
#LIBS     = -L$(LIBDIR) -lItems -lQuest -lMofus -lGameServerDatabase -lServerCore -lGameServerPackets -lSkill -lCore -lGameServerBilling -lLuaScript -lGameServerTest -lWar -lCouple -lMission -lCTF -lGameServerCBilling -lxerces-c -lsicuuc -lsicudata -lCSAuth -lstlport
#LIBS     = -L$(LIBDIR) -lItems -lQuest -lMofus -lGameServerDatabase -lServerCore -lGameServerPackets -lSkill -lCore -lGameServerBilling -lLuaScript -lWar -lCouple -lMission -lCTF -lGameServerCBilling -lxerces-c -lsicuuc -lsicudata -lCSAuth -lstlport
#SYSLIBS  = -L$(MYSQLDIR) -static -lpthread -lnsl -lutil -lmysqlclient -llua -llualib -lz -lcppunit -lm -lssl
#SYSLIBS  = -L$(MYSQLDIR) -static -lpthread -lnsl -lutil -ldl -lmysqlclient -llua -llualib -lz 
#SYSLIBS  = -L$(MYSQLDIR) -static -lpthread -lnsl -lutil -ldl -lmysqlclient -llua -llualib -lz -lcppunit
#LIBS     = -L$(LIBDIR) -lItems -lQuest -lMofus -lGameServerDatabase -lServerCore -lGameServerPackets -lSkill -lCore -lGameServerBilling -lLuaScript -lGameServerTest -lWar -lCouple -lMission -lCTF -lGameServerCBilling -lxerces-c -lsicuuc -lsicudata -lCSAuth
#SYSLIBS  = -L$(MYSQLDIR) -static -lpthread -lnsl -lutil -ldl -lmysqlclient -llua -llualib -lz -lcppunit -lsybdb
#LIBS     = -L$(LIBDIR) -lItems -lQuest -lMofus -lGameServerDatabase -lServerCore -lGameServerPackets -lSkill -lCore -lGameServerBilling -lLuaScript -lWar -lCouple -lMission -lCTF -lGameServerCBilling -lxerces-c -lsicuuc -lsicudata -lCSAuth
LIBS     = -L$(LIBDIR) -lItems -lQuest -lGameServerDatabase -lServerCore -lGameServerPackets -lSkill -lCore -lGameServerBilling -lDEScript -lWar -lCouple -lMission -lCTF -lGameServerCBilling -lxerces-c -lsicuuc -lsicudata -lCSAuth
SYSLIBS  = -L$(MYSQLDIR) -L/usr/local/lua-5.1.3/lib -static -lstlport -lpthread -lnsl -lutil -ldl -lmysqlclient -llua -lz -lsybdb

.cpp.o :
	$(CC) $(CCFLAGS) $(DEFS) $(INCLUDES) $<

