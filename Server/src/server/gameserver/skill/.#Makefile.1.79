OBJS = $(HANDLER_OBJS) $(SKILL_OBJS) $(EFFECT_OBJS)

SRCS = $(OBJS:.o=.cpp)

TARGET = $(LIBDIR)/libSkill.a

$(TARGET) : $(OBJS)
	ar rc $(TARGET) $(OBJS)

clean :
	rm -rf *.o $(TARGET)

cleanall :
	rm -rf *.o $(TARGET)

depall :
	gccmakedep $(SRCS) $(INCLUDES)

dep :
	gccmakedep $(SRCS) $(INCLUDES)
