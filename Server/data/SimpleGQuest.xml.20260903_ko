<?xml version="1.0" encoding="UTF-8"?>
<QuestList>
	<Quest id="101">
		<Title>어둠에 눈을 뜨라.</Title>
		<Script sender="브리콜라카스">자, 새롭게 얻은 힘을 느껴보고 싶은가? 후후… 하지만 아직 네 힘은 미약하기 짝이 없다. 그 상태로 성 밖을 나서봐야 버텨낼 수 없을 터. 하지만 지금 같은 전시에 네 녀석을 일일이 가르칠 여유는 없구나. 하지만 네 스스로 가능성을 보여준다면 가르침을 주겠다. 이곳 지하 1층 정도라면 지금의 너라도 감당이 가능하겠지. 그곳의 쓰레기들을 처리하도록 해라. 때가 되면 너를 부를 것이다.</Script>
		<Happen replay="false">
			<Race race="VAMPIRE" />
			<Level max="3" />
		</Happen>
		<CompleteMessage sender="브리콜라카스" target="92">음… 좋다. 너에게서 풍기는 피 냄새가 제법 쓸만하구나. 내가 너에게 능력을 전수해 주마.</CompleteMessage>
		<Complete>
			<Level min="6" index="1">레벨 6 이상 달성</Level>
		</Complete>
		<FailMessage sender="브리콜라카스" target="92">도대체 뭘 하고 있는 건가? 그런 식으로는 버러지 같은 인간 녀석들의 사냥감이 되기 딱이겠군…</FailMessage>
		<Fail>
			<Time limit="30" index="1">%s남은 시간 : %d분</Time>
		</Fail>
		<Reward>
			<GiveVampireExp amount="100" />
			<GiveMoney amount="10000" />
		</Reward>
	</Quest>
	<Quest id="102">
		<Title>뱀파이어로의 자각</Title>
		<Script sender="레베카">어린 뱀파이어여! 어째서 아직까지 피의 유혹을 거부하는 거죠? 
머리 속에 틀어박힌 하찮은 인간들의 윤리란 것이 신경 쓰이는 것인가요? 스스로가 원해서 인간 이길 포기한 주제에 아직까지 그런 것에 신경을 쓰고 있다니 우스운 일이군요. 하찮은 인간세상의 기억은 쓸모없는 것이죠. 우리 일족의 강대한 힘은 그냥 생겨나는 것이 아닙니다. 생명의 근원인 피를 통해 우리의 힘은 더욱 강해지는 것입니다. 강해지기 위해서라면 피를 마셔야 합니다.</Script>
		<Happen replay="false">
			<Race race="VAMPIRE" />
			<Level min="3" max="5" />
		</Happen>
		<CompleteMessage sender="레베카" target="255">이제 제법 흡혈에 익숙해졌나요? 이후에도 전투 중엔 항상 흡혈을 염두에 두어야 할 것입니다. 이제 마을의 카콘에게 맡겨둔 물건을 받도록 하십시오.</CompleteMessage>
		<Complete>
			<BloodDrain num="20" index="1">%s흡혈 회수 : %d / 20회</BloodDrain>
		</Complete>
		<FailMessage sender="레베카" target="255">숙명을 거부하겠다는 건가요? 뭐, 좋겠죠… 잿더미로 변한 후에 후회해도 소용없을 겁니다. 흐흠~</FailMessage>
		<Fail>
			<Time limit="15" index="1">%s남은 시간 : %d분</Time>
		</Fail>
		<Reward>
			<GiveItem class="SERUM" type="0" num="9" />
			<GiveVampireExp amount="100" />
		</Reward>
	</Quest>
	<Quest id="103">
		<Title>라르바를 설득하라.</Title>
		<Script sender="브리콜라카스">점점 일족으로서 성장해 나가는 자네를 마스터께서는 아주 흡족하게 생각하고 계신다네. 물론 앞으로도 기대를 저버리는 모습을 보여주진 않을거라 믿고 계시지. 하지만 가끔 어리석은 녀석들이 발견되기도 하네. 일족의 우수한 힘을 얻고도 인간이었을 때를 잊지 못하는 녀석들이지. 라르바라는 녀석이 그런 녀석들을 도와주고 있기 때문에 이런 일이 생기는 게야. 마스터께서는 무슨 생각으로 그 녀석을 내치지 않으시는지 모르겠어. 물론 라르바의 마력은 무시할 수 없는 것이긴 해. 그 자가 힘을 보태준다면 일족의 힘도 더욱 커질 텐데 말이야. 어떤가? 자네가 라르바를 한번 설득해보지 않겠나? 내 편지를 줄 테니 그와 얘기를 한번 해보게.</Script>
		<Happen replay="false">
			<Race race="VAMPIRE" />
			<Level min="10" max="14" />
		</Happen>
		<Complete>
			<SayNPC name="브리콜라카스" target="92" index="1">브리콜라카스에게서 편지를 받는다</SayNPC>
			<GiveQuestItem id="0" />
			<SayNPC name="라르바" target="368" index="2">라르바에게 편지를 전한다.</SayNPC>
			<Message index="3">브리콜라카스의 편지를 전하고 설득을 해보았지만 어째서인지 라르바는 말없이 고개를 저을 뿐이다. 라르바는 품 속에서 자신의 편지를 꺼내주며 브리콜라카스에게 전해 주라고 할 뿐이다.</Message>
			<LoseQuestItem id="0" />
			<GiveQuestItem id="1" />
			<GiveVampireExp amount="200" />

			<SayNPC name="브리콜라카스" target="92" index="4">브리콜라카스에게 편지를 전한다.</SayNPC>
			<Script sender="브리콜라카스" target="92" index="5">이거 참, 무슨 배짱으로 이런 결정을 내리는 지 알 수가 없군. 이런 식이라면 언젠가는 마스터님의 분노를 살 터인데… 음, 아무튼 수고했네. 앞으로도 계속 마스터에게 충실히 봉사할 수 있도록 하게.</Script>
			<LoseQuestItem id="1" />
			<GiveVampireExp amount="200" />
		</Complete>
		<FailMessage sender="브리콜라카스" target="92">너무 무리할 필요는 없네. 내가 자네를 너무 과대 평가한 모양이군.</FailMessage>
		<Fail>
			<Killed num="1" index="1">전달하는 과정에서 죽지 않아야 한다.</Killed>
		</Fail>
		<Reward>
			<GiveItem class="VAMPIRE_WEAPON" type="1" option="STR+3" />
			<GiveVampireExp amount="100" />
		</Reward>
	</Quest>
	<Quest id="104">
		<Title>순종적 동물</Title>
		<Script sender="카콘" target="220">하등한 존재인 주제에 반항만 하는 인간들에 비해 다른 동물들은 순종적이지. 물론 그렇다고 해서 다들 쓸모가 있는 건 아니야. 이 곳 에슬라니아 지방에는 예전부터 들개들이 번식하고 있었는데 이것들을 잘만 길들이면 꽤나 편리하지. 인간들도 이 녀석들을 이용한다고 하더군. 처음엔 길들이기 번거롭지만 쓸 만 할거야. 이 녀석들은 고기덩어리를 좋아한다니까 준비하는 걸 잊지 말게나.</Script>
		<Happen replay="false">
			<Race race="VAMPIRE" />
			<Level min="20" max="20" />
		</Happen>
		<CompleteMessage sender="카콘" target="220">지금 당장은 썩 쓸모있어 보이진 않겠지만 꾸준히 키우면 꽤 볼품이 있지. 잘만하면 자네의 능력에도 영향을 주기도 하지만 어디까지나 운이 꽤 좋아야 하네. 하지만 혹시라도 고약한 병에 걸린 녀석일지도 모르지. 림보성의 카파티니에게 보여주면 잘 살펴봐줄거야.</CompleteMessage>
		<Complete>
			<TamePet num="1" index="1">주니어울프아크를 길들여 울프독을 구한다.</TamePet>
		</Complete>
		<FailMessage sender="카콘" target="220">크크크, 하찮은 동물 하나 길들이지 못하다니 정말 딱하군… 어디 그래가지고 여기서 살아남기나 하겠나?</FailMessage>
		<Fail>
			<Time limit="20" index="1">%s남은 시간 : %d분</Time>
		</Fail>
		<Reward>
			<GiveItem class="PET_FOOD" type="3" num="5" />
			<GiveItem class="VAMPIRE_WEAPON" type="2" option="DAM+3" />
		</Reward>
	</Quest>
	<Quest id="105" type="tutorial">
		<Title>악마와의 계약</Title>
		<HappenRegion zoneid="22" x="230" y="231"/>
		<RewardMessage>Name: 릴리스 제라(Lilith Jera)
Option: VIS+2
Exp: 200
Money: 10,000겔드</RewardMessage>
		<Script sender="악마">자, 릴리스의 힘이 돌아오는 것인가? 후후… 내 목소리가 네 녀석에게는 무척 생소하게 들릴 것이다. 하지만 아직 네 녀석은 나를 볼 자격이 없다. 그렇다고 내 말을 거역한다면 단지 넌 그 상태로 비밀 요원들의 장난감이 될 것이다. 지금 같은 상황에서 네 녀석을 일일이 가르칠 여유는 없지만 네 스스로 전사로 향하는 가능성을 보여준다면 릴리스의 위대한 가르침은 너와 함께할 것이지만 단 조건이 있다. 넌 이제부터 나와 계약을 해야 한다. 자 그럼 나와 계약을 하기 전에 림보성의 브리콜라카스에게 가서 기본 장비와 필요한 자금을 받도록 하고 수행을 시작하도록 하라! 나와 계약하는 것은 결코 쉽지 않다는 것을 보여 주겠다. 때가 되면 너를 부르도록 하지. 으흐흐흐….</Script>
		<Happen replay="false">
			<Race race="VAMPIRE" />
			<Level min="4"/>
		</Happen>
		<CompleteMessage sender="악마" target="1022">나와 계약을 맺겠다고? 후후. 좋아, 퀘스트에서 미천한 네놈을 도와줄 나의 선물이다. 빼앗기거나 잃어버린다면 바로 네 목숨은 내 것이다. 이것은 곧 내 지시와도 같고 나의 지시는 곧 너의 피와도 같다. 절대 내 말을 잊지 말도록! </CompleteMessage>
		<Complete>
			<SayNPC name="브리콜라카스" target="92" index="1">브리콜라카스에게 말을 건다.</SayNPC>
		</Complete>
		<FailMessage sender="악마" target="1022">이런 나약해 빠진 놈 같으니라고!! 너를 평생 쫓아 다니며 괴롭혀 주겠다! 으하하하 </FailMessage>
		<Fail>
		</Fail>
		<Reward>
			<GiveVampireExp amount="200" />
			<GiveMoney amount="10000" />
			<GiveItem class="VAMPIRE_AMULET" type="15" option="VIS+2" limitedtime="2592000"/>
		</Reward>
	</Quest>
	<Quest id="106" type="adventure">
		<Title>지하 점령</Title>
		<HappenRegion zoneid="22" x="230" y="231"/>
		<RewardMessage>( 도메인 별 랜덤 무기 지급 )
Name: 릴리스 사브 너클(Lilith SAV Knuckle)
Option: STR+3 / INT+3</RewardMessage>
		<Script sender="악마">이젠 네놈과 나는 계약을 통해 언제 어디서든지 내가 임무를 지시 할 수 있지. 너는 이미 나와 계약을 했으니 도망갈 길은 없다는 것을 알아두는 것이 좋을 것이야. 누구에게도 발설하는 순간에는 죽음을 줄 테니 각오 하는 것이 좋아! 우선 릴리스가 예언한 전사가 맞는지 확인을 해보겠다. 이곳 던전에는 보다시피 쓰레기들이 아주 많지. 나의 지시에 따라 몬스터의 목을 따오도록 하라! 그럼 네가 가진 보석들이 핏빛으로 물들어 가는 것을 볼 수 있을 것이다. 아주 중요한 것 이니 확인 하지 않으면 내가 아주 실망할지도 몰라. 넌 이제 나의 소유라는 것을 잊지 말도록!</Script>
		<Happen replay="false">
			<Race race="VAMPIRE" />
			<Level min="7" />
			<EnterZone ZoneID="1003" />
		</Happen>
		<CompleteMessage sender="악마" target="1022">흠, 생각보다는 괜찮은 실력이군. 난 항상 너를 보고 있다는 것을 잊지 말도록. 이 보상은 내가 주는 채찍질이니 앞으로도 더욱 더 나를 기쁘게 하라!</CompleteMessage>
		<Complete>
			<KillMonster num="5" sort="1" index="1">%s 치프 데드바디 머리 사냥 : %d / 5 
		    	<Target type="564" />
			</KillMonster>
		</Complete>
		<FailMessage sender="악마" target="1022">네 놈에겐 더욱 큰 고통이 필요한 것이냐 죽음이 필요한 것이냐?</FailMessage>
		<Fail>
			<Time limit="60" index="1">%s남은 시간 : %d분</Time>
		</Fail>
		<Reward>
			<Random>
	    		<GiveItem class="VAMPIRE_WEAPON" type="25" option="STR+3" limitedtime="2592000" />
	    		<GiveItem class="VAMPIRE_WEAPON" type="25" option="INT+3" limitedtime="2592000" />
			</Random>
		</Reward>
	</Quest>
	<Quest id="107" type="charge">
		<Title>라르바의 취향</Title>
		<HappenRegion zoneid="23" x="130" y="86"/>
		<RewardMessage>박쥐날개 20개(Bat Wing)
No. 108 퀘스트 시작</RewardMessage>
		<Script sender="악마">자 그럼 첫 번째 주문을 내려 보도록 하겠어. 우선 림보 남동의 라르바에게 이것을 가지고 가라. 그 녀석의 취향은 좀 독특하긴 하지만 그는 네가 순수한 뱀파이어 혈통으로써 모든 수행을 이겨나갈 도움을 줄 것 이다. 고통으로 가득 찬 너의 고생길은 이제 시작에 불과 하다. 그럼 잔말 말고 이걸 가지고 림보남동의 라르바에게 가서 내 임무를 기다리도록 해!</Script>
		<Happen replay="false">
			<Race race="VAMPIRE" />
			<Level min="11" />
		</Happen>
		<CompleteMessage sender="라르바" target="368">흠 당신이 바로 릴리스의 후예? 그런데 그 역겨운 머리는 도대체 어떻게 가져왔나? 사실 그것은 제가 모으는 재료 중의 하나라는걸 아는 사람은 몇 안되지 후후.. 좋다 자네에게 당장은 필요 없겠지만 아마 나중에 긴히 쓸 일이 생길 것이니 잘 모아 두도록 하라구.</CompleteMessage>
		<Complete>
			<GiveQuestItem id="27" />
			<SayNPC name="라르바" target="368" index="1">라르바에게 말을 건다.</SayNPC>
			<LoseQuestItem id="27" />
		</Complete>
		<FailMessage sender="악마" target="1022">왜 다시 돌아왔나? 뭐! 박쥐 머리가 사라졌다고? 도대체 그걸 어디다 쓴거냐 이 멍청한 놈아!</FailMessage>
		<Fail>
		</Fail>
		<Reward>
			<GiveItem class="VAMPIRE_ETC" type="1" num="20" limitedtime="2592000"/>
			<StartOtherQuest id="108"/>
       	</Reward>
	</Quest>
	<Quest id="108" type="charge">
		<Title>혐오스러운 임무</Title>
		<HappenRegion zoneid="23" x="130" y="86"/>
		<RewardMessage>Name: 릴리스 슬리퍼리 로브(Lilith Slipery Robe)
Option: ATTR+2
릴리스 플룸 클록(Lilith Plume Cloak)
Option: ATTR+2 (남/여 구분)</RewardMessage>
		<Script sender="악마">자 그럼 임무를 주도록 하겠다. 최근 들어 나의 심기를 불편하게 만드는 녀석들이 나타났단 말이야. 사실 그 녀석들은 내가 쉽게 처리할 수 있는 아주 간단한 녀석들이지만 네놈 역시 하찮은 존재! 그 놈들의 상대도 안된다면 네놈은 나와 대화할 가치 조차도 없다! 최근 림보성 남동 지역에서 우리와 같은 눈을 하고 정탐하는 쓰레기 같은 녀석들이다. 아마도 어디서 하등한 훈련을 받고 눈속임을 사용하는 것 같다. 그 놈들이 나타나는 림보성 남동 지역으로 가서 더러운 자들을 쓸어내라! 림보성 남동 지점이다. 신속하게 처단해 내야 한다. 자 그럼 임무를 시작 하도록! </Script>
		<Happen replay="false">
			<Race race="VAMPIRE" />
			<Level min="11" />
			<CompleteQuest id="107" />	
		</Happen>
		<CompleteMessage sender="악마" target="1022">앞으로 더욱 잔인한 임무를 내릴 것 이다. 부디 몸조심 하기를… 하하하</CompleteMessage>
