			<Time limit="20" index="1">%s남은 시간 : %d분</Time>
		</Fail>
		<Reward>
			<GiveQuestItem id="2" />
			<SayNPC name="낸시" target="303" index="1">보급표를 가지고 낸시에게 가서 보급품을 받는다</SayNPC>
