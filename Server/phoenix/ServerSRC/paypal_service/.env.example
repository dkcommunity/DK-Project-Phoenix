# Phoenix PayPal Cash servisi — ortam değişkenleri şablonu.
# Gerçek dosya (paypal.env / .env) ASLA repo'ya girmez; chmod 600 tutulur.

# PayPal Developer Console > Apps & Credentials > REST app
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# sandbox | live  (sandbox => api-m.sandbox.paypal.com, live => api-m.paypal.com)
PAYPAL_MODE=sandbox

# Developer Console > Webhooks > webhook detay sayfasındaki Webhook ID
PAYPAL_WEBHOOK_ID=

# Public base URL (nginx TLS sonlandırma), sonda '/' olmadan
BASE_URL=https://pay.example.duckdns.org

# Varsayılan para birimi (CashPackages satırında Currency boşsa kullanılır)
CURRENCY=USD

# DARKEDEN MySQL bağlantısı
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=elcastle
DB_PASS=change-me
DB_NAME=DARKEDEN

# Log dosyası (systemd unit'te ReadWritePaths ile izin verilen yol olmalı)
LOG_FILE=/var/log/paypal_service.log
